{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/understand.js": {
      "maxDuration": 15
    },
    "api/assistant.js": {
      "maxDuration": 25
    }
  },
  "git": {
    "deploymentEnabled": {
      "visual-picker": false
    }
  }
}
