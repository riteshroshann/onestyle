{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "functions": {
    "api/understand.js": {
      "maxDuration": 15
    },
    "api/next.js": {
      "maxDuration": 12
    },
    "api/transcribe.js": {
      "maxDuration": 25
    },
    "api/assistant.js": {
      "maxDuration": 25
    },
    "api/vision.js": {
      "maxDuration": 25
    }
  },
  "git": {
    "deploymentEnabled": {
      "visual-picker": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
