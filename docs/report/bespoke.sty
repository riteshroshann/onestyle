\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bespoke}[2026/10/04 BESPOKE research plan style]

% ---------- page ----------
\RequirePackage[a4paper,inner=30mm,outer=30mm,top=32mm,bottom=36mm,footskip=14mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\setmainfont{LibertinusSerif}[Extension=.otf,UprightFont=*-Regular,BoldFont=*-Semibold,ItalicFont=*-Italic,BoldItalicFont=*-SemiboldItalic,Numbers=Lining]
\setmathfont{LibertinusMath-Regular.otf}
\setmonofont{LibertinusMono-Regular.otf}[Scale=0.88]
\newfontfamily\deva{Nirmala.ttc}[Path=./fonts/,Script=Devanagari,FontIndex=0,Scale=0.92]
\RequirePackage{microtype}
\linespread{1.18}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.62\baselineskip plus 2pt minus 1pt}
\raggedbottom
\emergencystretch=2em
\clubpenalty=10000
\widowpenalty=10000

% ---------- colour ----------
\RequirePackage{xcolor}
\definecolor{ink}{HTML}{1E1E1E}
\definecolor{soft}{HTML}{6B6B6B}
\definecolor{faint}{HTML}{9A9A9A}
\definecolor{accent}{HTML}{7A4A1C}
\color{ink}

% diagram palette, after the CFFM-Net figures
\definecolor{blueF}{HTML}{E9F0FA}\definecolor{blueD}{HTML}{8AA9D6}\definecolor{blueT}{HTML}{3D63A8}
\definecolor{peachF}{HTML}{FBEEE7}\definecolor{peachD}{HTML}{DFA48C}\definecolor{peachT}{HTML}{A9502C}
\definecolor{greenF}{HTML}{E8F3EC}\definecolor{greenD}{HTML}{8FC0A0}\definecolor{greenT}{HTML}{2F7A4B}
\definecolor{lavF}{HTML}{EFEAF8}\definecolor{lavD}{HTML}{A897D1}\definecolor{lavT}{HTML}{5E46A0}
\definecolor{greyF}{HTML}{F2F2F2}\definecolor{greyD}{HTML}{B9B9B9}\definecolor{greyT}{HTML}{5A5A5A}
\definecolor{sandF}{HTML}{FBF4E3}\definecolor{sandD}{HTML}{D9BE86}\definecolor{sandT}{HTML}{8A6A22}
\definecolor{roseF}{HTML}{FBECF0}\definecolor{roseD}{HTML}{D99AAD}\definecolor{roseT}{HTML}{A33A5B}
\definecolor{arrow}{HTML}{5C5C5C}
\definecolor{ph0}{HTML}{8B5E1A}\definecolor{ph1}{HTML}{3B6FC1}\definecolor{ph2}{HTML}{7A4FB5}
\definecolor{ph3}{HTML}{D2652B}\definecolor{ph4}{HTML}{B83250}\definecolor{ph5}{HTML}{2F8A5B}
\definecolor{ph6}{HTML}{4A4A4A}

% ---------- headings ----------
\RequirePackage[explicit]{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\raggedright}
  {\large\scshape\color{soft}chapter \thechapter}
  {6pt}
  {\fontsize{25}{30}\selectfont #1}
\titleformat{name=\chapter,numberless}[display]
  {\normalfont\raggedright}{}{0pt}{\fontsize{25}{30}\selectfont #1}
\titlespacing*{\chapter}{0pt}{18mm}{16mm}
\titleformat{\section}{\normalfont\Large\raggedright}{\thesection\hspace{1em}}{0pt}{#1}
\titlespacing*{\section}{0pt}{2.2\baselineskip}{0.6\baselineskip}
\titleformat{\subsection}{\normalfont\large\itshape\raggedright}{}{0pt}{#1}
\titlespacing*{\subsection}{0pt}{1.5\baselineskip}{0.3\baselineskip}
\titleformat{\paragraph}[runin]{\normalfont\scshape}{}{0pt}{#1.}
\titlespacing*{\paragraph}{0pt}{0.8\baselineskip}{0.8em}
\setcounter{secnumdepth}{1}
\setcounter{tocdepth}{1}

% ---------- page style: footer number only, no rules ----------
\RequirePackage{fancyhdr}
\fancypagestyle{body}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[C]{\small\color{soft}\thepage}}
\fancypagestyle{plain}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
  \fancyfoot[C]{\small\color{soft}\thepage}}

% ---------- contents: no leaders ----------
\RequirePackage{tocloft}
\renewcommand{\cftdotsep}{\cftnodots}
\renewcommand{\cftchapfont}{\normalfont\large}
\renewcommand{\cftchappagefont}{\normalfont\large\color{soft}}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont\color{soft}}
\setlength{\cftbeforechapskip}{11pt}
\setlength{\cftbeforesecskip}{3pt}
\setlength{\cftchapnumwidth}{2.2em}
\setlength{\cftsecindent}{2.2em}
\setlength{\cftsecnumwidth}{2.6em}
\renewcommand{\cfttoctitlefont}{\normalfont\fontsize{25}{30}\selectfont}
\renewcommand{\cftaftertoctitle}{\par\vspace{10mm}}
\setlength{\cftbeforetoctitleskip}{18mm}
\setlength{\cftaftertoctitleskip}{0pt}

% ---------- figures, tables, captions ----------
\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{caption}
\DeclareCaptionFont{soft}{\color{soft}}
\DeclareCaptionFont{ink}{\color{ink}}
\captionsetup{font={small,soft},labelfont={sc,ink},labelsep=quad,justification=raggedright,singlelinecheck=false,skip=10pt}
\RequirePackage{array,tabularx}
\renewcommand{\arraystretch}{1.42}
\setlength{\tabcolsep}{7pt}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{P}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcommand{\thd}[1]{{\small\itshape\color{soft}#1}}
\newcommand{\gap}{\noalign{\vskip 5pt}}
\setlength{\intextsep}{16pt}
\setlength{\textfloatsep}{20pt}
\setlength{\floatsep}{18pt}

% ---------- lists ----------
\RequirePackage{enumitem}
\setlist{itemsep=3pt,topsep=2pt,parsep=0pt,leftmargin=1.6em}
\setlist[enumerate]{label={\arabic*.}}

% ---------- code ----------
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\small\color{ink},columns=fullflexible,keepspaces=true,
  frame=none,xleftmargin=1.4em,aboveskip=8pt,belowskip=6pt,breaklines=true,
  showstringspaces=false,upquote=true}

% ---------- maths ----------
\RequirePackage{amsmath}

% ---------- links ----------
\RequirePackage[hidelinks,unicode,pdfusetitle]{hyperref}
\RequirePackage{xurl}
\urlstyle{same}

% ---------- tikz ----------
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,fit,backgrounds,calc,shapes.misc,shapes.geometric,decorations.pathreplacing,matrix,chains}
\tikzset{
  >={Stealth[length=4.2pt,width=3.4pt]},
  every picture/.style={line width=0.5pt,font=\small},
  every node/.append style={execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000}},
  box/.style={draw,rounded corners=2.5pt,align=center,inner xsep=7pt,inner ysep=5pt,font=\small},
  blue/.style={box,fill=blueF,draw=blueD},
  peach/.style={box,fill=peachF,draw=peachD},
  green/.style={box,fill=greenF,draw=greenD},
  lav/.style={box,fill=lavF,draw=lavD},
  grey/.style={box,fill=greyF,draw=greyD},
  sand/.style={box,fill=sandF,draw=sandD},
  rose/.style={box,fill=roseF,draw=roseD},
  planned/.style={dashed},
  group/.style={draw,dashed,rounded corners=6pt,inner sep=9pt},
  gtitle/.style={font=\small\scshape,anchor=south west,inner sep=1pt},
  flow/.style={->,draw=arrow},
  dflow/.style={->,draw=arrow,dashed},
  note/.style={font=\footnotesize\itshape,text=soft,align=left},
  tiny/.style={font=\scriptsize,text=soft},
}

% ---------- small helpers ----------
\newcommand{\sys}{\textsc{bespoke}}
\newcommand{\term}[1]{\emph{#1}}
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\hi}[1]{{\deva #1}}
